{
  "name": "@kgdiff/layout",
  "version": "0.1.0",
  "description": "Stable, deterministic, label-aware layout for graph diffs: both versions share one mental map.",
  "keywords": [
    "kgdiff",
    "layout",
    "force-directed"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "d3-force": "3.0.0",
    "d3-quadtree": "3.0.1"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/d3-quadtree": "3.0.6"
  }
}
