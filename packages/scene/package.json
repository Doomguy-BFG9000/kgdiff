{
  "name": "@kgdiff/scene",
  "version": "0.1.0",
  "description": "Renderer-agnostic visual model for graph diffs: design tokens, encodings, replay timeline and focus.",
  "keywords": [
    "kgdiff",
    "visualization"
  ],
  "homepage": "https://github.com/TODO-OWNER/kgdiff/tree/main/packages/scene#readme",
  "bugs": {
    "url": "https://github.com/TODO-OWNER/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-OWNER/kgdiff.git",
    "directory": "packages/scene"
  },
  "funding": "https://github.com/sponsors/TODO-OWNER",
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "@kgdiff/layout": "workspace:*"
  }
}
