<?xml version="1.0" encoding="UTF-8"?>
<!-- people.ttl in RDF/XML: entities from the DTD (as older Protégé writes them), xml:base,
     typed node elements, a property attribute, xml:lang, rdf:datatype, rdf:nodeID and an
     RDF list spelled out with rdf:parseType="Resource" (Collection only holds resources). -->
<!DOCTYPE rdf:RDF [
  <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xmlns:rdf="&rdf;"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:schema="http://schema.org/"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:ex="https://example.org/people/"
         xml:base="https://example.org/people/">

  <schema:Person rdf:about="alice">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <schema:name>Alice Liddell</schema:name>
    <rdfs:label xml:lang="en">Alice</rdfs:label>
    <rdfs:label xml:lang="zh">爱丽丝</rdfs:label>
    <rdfs:label xml:lang="es">Alicia</rdfs:label>
    <skos:altLabel>Al</skos:altLabel>
    <schema:birthDate rdf:datatype="&xsd;date">1852-05-04</schema:birthDate>
    <schema:height rdf:datatype="&xsd;decimal">1.62</schema:height>
    <ex:age rdf:datatype="&xsd;integer">27</ex:age>
    <ex:verified rdf:datatype="&xsd;boolean">true</ex:verified>
    <ex:nickname xml:lang="en-GB">Ally</ex:nickname>
    <ex:favouriteNumbers rdf:parseType="Resource">
      <rdf:first rdf:datatype="&xsd;integer">3</rdf:first>
      <rdf:rest rdf:parseType="Resource">
        <rdf:first rdf:datatype="&xsd;integer">7</rdf:first>
        <rdf:rest rdf:parseType="Resource">
          <rdf:first rdf:datatype="&xsd;integer">42</rdf:first>
          <rdf:rest rdf:resource="&rdf;nil"/>
        </rdf:rest>
      </rdf:rest>
    </ex:favouriteNumbers>
    <schema:knows rdf:resource="bob"/>
    <schema:knows rdf:resource="carol"/>
    <schema:address rdf:nodeID="oxford"/>
  </schema:Person>

  <rdf:Description rdf:nodeID="oxford">
    <schema:addressLocality>Oxford</schema:addressLocality>
    <schema:addressCountry>GB</schema:addressCountry>
  </rdf:Description>

  <schema:Person rdf:about="bob" schema:name="Bob">
    <schema:knows rdf:resource="alice"/>
    <ex:score rdf:datatype="&xsd;integer">9007199254740993</ex:score>
  </schema:Person>

  <rdf:Description rdf:about="carol">
    <schema:name xml:lang="zh">卡罗尔</schema:name>
    <schema:name xml:lang="en">Carol</schema:name>
    <schema:worksFor rdf:resource="https://example.org/org/acme"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://schema.org/worksFor">
    <rdfs:label xml:lang="en">works for</rdfs:label>
  </rdf:Description>
</rdf:RDF>
