# people.ttl as N-Triples, statements in reverse order.
<http://schema.org/worksFor> <http://www.w3.org/2000/01/rdf-schema#label> "works for"@en .
<https://example.org/people/carol> <http://schema.org/worksFor> <https://example.org/org/acme> .
<https://example.org/people/carol> <http://schema.org/name> "Carol"@en .
<https://example.org/people/carol> <http://schema.org/name> "卡罗尔"@zh .
<https://example.org/people/bob> <https://example.org/people/score> "9007199254740993"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://example.org/people/bob> <http://schema.org/knows> <https://example.org/people/alice> .
<https://example.org/people/bob> <http://schema.org/name> "Bob" .
<https://example.org/people/bob> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://schema.org/Person> .
<https://example.org/people/alice> <http://schema.org/address> _:b3 .
_:b3 <http://schema.org/addressCountry> "GB" .
_:b3 <http://schema.org/addressLocality> "Oxford" .
<https://example.org/people/alice> <http://schema.org/knows> <https://example.org/people/carol> .
<https://example.org/people/alice> <http://schema.org/knows> <https://example.org/people/bob> .
<https://example.org/people/alice> <https://example.org/people/favouriteNumbers> _:b0 .
_:b2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:b2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "42"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:b1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:b2 .
_:b1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "7"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:b1 .
_:b0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> "3"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://example.org/people/alice> <https://example.org/people/nickname> "Ally"@en-gb .
<https://example.org/people/alice> <https://example.org/people/verified> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
<https://example.org/people/alice> <https://example.org/people/age> "27"^^<http://www.w3.org/2001/XMLSchema#integer> .
<https://example.org/people/alice> <http://schema.org/height> "1.62"^^<http://www.w3.org/2001/XMLSchema#decimal> .
<https://example.org/people/alice> <http://schema.org/birthDate> "1852-05-04"^^<http://www.w3.org/2001/XMLSchema#date> .
<https://example.org/people/alice> <http://www.w3.org/2004/02/skos/core#altLabel> "Al" .
