# A small FOAF / schema.org graph: multilingual labels, typed literals, a list and a blank node.
@prefix ex: <https://example.org/people/> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:alice a schema:Person, foaf:Person ;
    schema:name "Alice Liddell" ;
    rdfs:label "Alice"@en, "爱丽丝"@zh, "Alicia"@es ;
    skos:altLabel "Al" ;
    schema:birthDate "1852-05-04"^^xsd:date ;
    schema:height "1.62"^^xsd:decimal ;
    ex:age 27 ;
    ex:verified true ;
    ex:nickname "Ally"@en-GB ;
    ex:favouriteNumbers ( 3 7 42 ) ;
    schema:knows ex:bob, ex:carol ;
    schema:address [
        schema:addressLocality "Oxford" ;
        schema:addressCountry "GB"
    ] .

ex:bob a schema:Person ;
    schema:name "Bob" ;
    schema:knows ex:alice ;
    ex:score "9007199254740993"^^xsd:integer .

ex:carol schema:name "卡罗尔"@zh, "Carol"@en ;
    schema:worksFor <https://example.org/org/acme> .

schema:worksFor rdfs:label "works for"@en .
