{
  "@context": {
    "ex": "https://example.org/people/",
    "schema": "http://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": "schema:name",
    "knows": { "@id": "schema:knows", "@type": "@id" },
    "label": { "@id": "rdfs:label", "@container": "@language" },
    "favouriteNumbers": { "@id": "ex:favouriteNumbers", "@container": "@list" }
  },
  "@graph": [
    {
      "@id": "ex:alice",
      "@type": ["schema:Person", "foaf:Person"],
      "name": "Alice Liddell",
      "label": { "en": "Alice", "zh": "爱丽丝", "es": "Alicia" },
      "skos:altLabel": "Al",
      "schema:birthDate": { "@value": "1852-05-04", "@type": "xsd:date" },
      "schema:height": { "@value": "1.62", "@type": "xsd:decimal" },
      "ex:age": 27,
      "ex:verified": true,
      "ex:nickname": { "@value": "Ally", "@language": "en-GB" },
      "favouriteNumbers": [3, 7, 42],
      "knows": ["ex:bob", "ex:carol"],
      "@reverse": { "knows": "ex:bob" },
      "schema:address": {
        "schema:addressLocality": "Oxford",
        "schema:addressCountry": "GB"
      }
    },
    {
      "@id": "ex:bob",
      "@type": "schema:Person",
      "name": "Bob",
      "ex:score": { "@value": "9007199254740993", "@type": "xsd:integer" }
    },
    {
      "@id": "ex:carol",
      "name": [{ "@value": "卡罗尔", "@language": "zh" }, { "@value": "Carol", "@language": "en" }],
      "schema:worksFor": { "@id": "https://example.org/org/acme" }
    },
    {
      "@id": "schema:worksFor",
      "label": { "en": "works for" }
    }
  ]
}
