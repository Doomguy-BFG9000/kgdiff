subsetdef: goslim_generic "Generic GO slim"
synonymtypedef: systematic_synonym "Systematic synonym" EXACT
default-namespace: gene_ontology
idspace: GO http://purl.obolibrary.org/obo/GO_ "Gene Ontology"
remark: A tiny excerpt of the Gene Ontology used by the kgdiff tests.
ontology: go

! The root of the biological process branch.
[Term]
id: GO:0008150
name: biological_process
namespace: biological_process
alt_id: GO:0000004
alt_id: GO:0007582
def: "A biological process is the execution of a genetically-encoded biological module or program." [GOC:pdt]
comment: Note that this term is recommended for the annotation of gene products whose biological process is unknown.
subset: goslim_generic
synonym: "biological process" EXACT []
synonym: "physiological process" EXACT []
xref: Wikipedia:Biological_process
created_by: jl
creation_date: 2009-04-28T10:13:17Z

[Term]
id: GO:0005739
name: mitochondrion
namespace: cellular_component
def: "A semiautonomous, self replicating organelle that occurs in varying numbers, shapes, and sizes in the cytoplasm of virtually all eukaryotic cells." [GOC:giardia, ISBN:0198506732 "Oxford Dictionary of Biochemistry"]
synonym: "mitochondria" EXACT []
synonym: "mito" RELATED [GOC:mah] {source="GOC:mah"}
xref: NIF_Subcellular:sao1860313010 "mitochondrion"
xref: Wikipedia:Mitochondrion
is_a: GO:0043231 ! intracellular membrane-bounded organelle
relationship: part_of GO:0005737 ! cytoplasm

[Term]
id: GO:0031966
name: mitochondrial membrane
namespace: cellular_component
def: "Either of the lipid bilayers that surround the mitochondrion and form the mitochondrial envelope." [GOC:mah, NIF_Subcellular:sao1045389829]
is_a: GO:0031090 ! organelle membrane
intersection_of: GO:0016020 ! membrane
intersection_of: part_of GO:0005740 ! mitochondrial envelope
relationship: part_of GO:0005740 ! mitochondrial envelope

[Term]
id: GO:0000001
name: mitochondrion inheritance
def: "The distribution of \"mitochondria\", including the mitochondrial genome, into daughter cells after mitosis or meiosis." [GOC:mcc, PMID:10873824, PMID:11389764]
synonym: "mitochondrial inheritance" EXACT []
is_a: GO:0048308 {is_inferred="false"} ! organelle inheritance
is_a: GO:0048311 ! mitochondrion distribution
property_value: IAO:0000233 "https://github.com/geneontology/go-ontology/issues/1" xsd:anyURI
property_value: GOREL:0000040 "2" xsd:integer

[Term]
id: GO:0000005
name: obsolete ribosomal chaperone activity
namespace: molecular_function
def: "OBSOLETE. Assists in the correct assembly of ribosomes or ribosomal subunits in vivo." [GOC:jl]
comment: This term was made obsolete because it refers to a class of gene products and a biological process rather than a molecular function.
is_obsolete: true
replaced_by: GO:0042254
consider: GO:0042254
consider: GO:0044183

[Typedef]
id: part_of
name: part of
namespace: external
xref: BFO:0000050
is_transitive: true
