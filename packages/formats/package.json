{
  "name": "@kgdiff/formats",
  "version": "0.1.0",
  "description": "Parsers that turn RDF (Turtle, N-Triples, N-Quads, TriG, RDF/XML, JSON-LD), OBO and common JSON graph shapes into kgdiff graphs.",
  "keywords": [
    "kgdiff",
    "rdf",
    "turtle",
    "rdf-xml",
    "owl",
    "json-ld",
    "obo",
    "parser"
  ],
  "homepage": "https://github.com/TODO-OWNER/kgdiff/tree/main/packages/formats#readme",
  "bugs": {
    "url": "https://github.com/TODO-OWNER/kgdiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-OWNER/kgdiff.git",
    "directory": "packages/formats"
  },
  "funding": "https://github.com/sponsors/TODO-OWNER",
  "license": "MIT",
  "author": "iiwish",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "n3": "2.13.12"
  },
  "devDependencies": {
    "@types/n3": "1.26.6"
  }
}
