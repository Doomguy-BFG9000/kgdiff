{
  "name": "@kgdiff/formats",
  "version": "0.1.0",
  "description": "Parsers that turn RDF (Turtle, N-Triples, N-Quads, TriG), OBO and common JSON graph shapes into kgdiff graphs.",
  "keywords": [
    "kgdiff",
    "rdf",
    "turtle",
    "obo",
    "parser"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kgdiff/core": "workspace:*",
    "n3": "2.13.12"
  },
  "devDependencies": {
    "@types/n3": "1.26.6"
  }
}
