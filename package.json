{
  "name": "kgdiff-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "git diff for knowledge graphs: semantic, visual diff and review for graph data.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck && tsc -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:site": "pnpm --filter @kgdiff/site dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
